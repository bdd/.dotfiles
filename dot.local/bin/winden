#!/usr/bin/env bash
set -euo pipefail

WINDEN_MBOX=mailbox.winden.app/v1
WINDEN_RELAY=relay.winden.app:4001

if [[ -z ${WORMHOLE-} ]]; then
  WORMHOLE=(wormhole-rs wormhole)
fi

read -ra impls < <(type -p "${WORMHOLE[@]}" || echo)
if (( ${#impls[@]} == 0 )); then
  echo "No supported Magic Wormhole implementation found in PATH." >&2
  exit 69 # EX_UNAVAILABLE
fi
impl=$(basename "${impls[0]}")

action=${1-}
if ! [[ ${action} =~ ^(send|receive)$ ]]; then
  echo "winden is only for send or receive of files or dirs" >&2
  exit 64 # EX_USAGE
fi
shift

case ${impl} in
  wormhole-rs)
    args=("${action}" --rendezvous-server "ws://${WINDEN_MBOX}" --relay-server "tcp://${WINDEN_RELAY}" "$@")
    #                                      ^^^^^
    # wormhole-rs default feauture set does NOT include TLS support.
    ;;
  wormhole)
    args=(--relay-url "wss://${WINDEN_MBOX}" --transit-helper "tcp:${WINDEN_RELAY}" "${action}" "$@")
    ;;
  *)
    echo "Unknown wormhole implementation '${impl}'" >&2
    exit 64 # EX_USAGE
esac

exec ${impl} "${args[@]}"
